---
import BaseLayout from '@components/BaseLayout.astro';
---

<BaseLayout
  title="MotionLoom - GPU Effect Engine"
  description="MotionLoom is Anica's GPU-accelerated effect and motion graph engine. Live demo with full graph DSL."
  ogImage="/motionloom-og.png"
>
  <section class="page-shell py-16">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="inline-flex rounded-full border-2 border-anica-ink bg-anica-lime px-4 py-2 font-mono text-xs font-bold uppercase tracking-[0.24em] shadow-[4px_4px_0_#11120d]">
        GPU effect engine
      </p>
      <h1 class="mt-8 text-5xl font-black leading-[0.9] tracking-[-0.08em] text-anica-ink md:text-7xl">
        MotionLoom
      </h1>
      <p class="mt-6 text-xl leading-8 text-anica-steel">
        A graph-based video effects and motion graphics engine built on WGPU. This playground shows the direction for Anica: visual animation controls that write real MotionLoom DSL.
      </p>
    </div>
  </section>

  <section class="page-shell py-4 md:py-8">
    <div id="motionloom-playground-panel" class="grid max-w-full gap-4 overflow-hidden rounded-[2.5rem] border-2 border-anica-ink bg-anica-ink p-4 ink-panel md:gap-6 md:p-10">
      <div class="hidden text-center lg:block">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-anica-lime">Live playground</p>
        <h2 class="mt-3 text-3xl font-black tracking-[0.06em] text-anica-paper md:text-4xl">Controls &rarr; DSL &rarr; Preview</h2>
        <p class="mx-auto mt-3 max-w-xl text-lg leading-8 text-anica-paper/72">
          Adjust animation values in the control panel, inspect the generated XML-like graph, then render the same DSL in the browser preview.
        </p>
      </div>

      <div id="motionloom-workspace" class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="order-2 flex min-w-0 flex-col gap-3 lg:order-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">MotionLoom Graph</p>
            <div class="flex shrink-0 gap-2">
              <button id="btn-reset" class="rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Process</button>
              <button id="btn-scene" class="rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Scene</button>
            </div>
          </div>
          <div id="github-example-bar" class="flex w-full min-w-0 flex-wrap items-center gap-2 rounded-2xl border border-anica-paper/15 bg-anica-paper/5 px-3 py-2">
            <span class="shrink-0 font-mono text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper/60">GitHub example</span>
            <select
              id="example-category"
              class="min-w-0 max-w-full flex-1 rounded-full border border-anica-paper/25 bg-anica-ink/70 px-3 py-1 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
            >
              <option value="showcase">showcase</option>
              <option value="scene">scene</option>
              <option value="process">process</option>
              <option value="text">text</option>
              <option value="material_and_texture">material_and_texture</option>
            </select>
            <input
              id="showcase-number"
              class="w-16 rounded-full border border-anica-paper/25 bg-anica-ink/70 px-3 py-1 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
              inputmode="numeric"
              min="1"
              placeholder="1"
              type="number"
              value="1"
            />
            <button id="btn-load-showcase" class="shrink-0 rounded-full border border-anica-paper/30 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Load</button>
            <button id="btn-empty-scene-template" class="shrink-0 rounded-full border border-anica-lime/40 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">Empty template</button>
            <select id="svg-import-mode" class="shrink-0 rounded-full border border-anica-lime/40 bg-anica-black px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime outline-none transition hover:bg-anica-lime/10">
              <option value="svg">Import as SVG tag</option>
              <option value="path">Import as Path DSL</option>
            </select>
            <label class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-full border border-anica-lime/25 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">
              <input id="svg-skip-background" type="checkbox" class="h-3 w-3 accent-anica-lime" checked />
              Skip SVG background
            </label>
            <label class="shrink-0 cursor-pointer rounded-full border border-anica-lime/40 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">
              <input id="svg-import" type="file" accept=".svg,image/svg+xml" class="hidden" />
              Import SVG
            </label>
          </div>
          <div id="process-github-example-bar" class="hidden w-full min-w-0 flex-wrap items-center gap-2 rounded-2xl border border-anica-paper/15 bg-anica-paper/5 px-3 py-2">
            <span class="shrink-0 font-mono text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper/60">GitHub process example</span>
            <select
              id="process-example-select"
              class="min-w-0 max-w-full flex-1 rounded-full border border-anica-paper/25 bg-anica-ink/70 px-3 py-1 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
            >
              <option value="">Loading process examples...</option>
            </select>
            <button id="btn-load-process-example" class="shrink-0 rounded-full border border-anica-paper/30 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Load</button>
          </div>
          <div id="animation-controls-panel" class="rounded-2xl border border-anica-paper/15 bg-anica-paper/5 p-3">
            <div class="mb-3">
              <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.22em] text-anica-lime">Scene controls</p>
              <p class="mt-1 text-xs text-anica-paper/45">Select a Group id and variable from the current DSL, then edit its value.</p>
            </div>

            <label class="mb-3 grid gap-2">
              <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.18em] text-anica-paper/60">Group id</span>
              <select
                id="group-control-select"
                class="rounded-xl border border-anica-paper/25 bg-anica-ink/70 px-3 py-2 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
              ></select>
            </label>

            <div class="motionloom-control-grid">
              <label class="motionloom-control">
                <span>Variable</span>
                <select id="group-variable-select"></select>
              </label>
              <label class="motionloom-control">
                <span>Value</span>
                <input id="group-variable-value" type="text" inputmode="decimal" autocomplete="off" />
              </label>
            </div>
            <p id="group-control-status" class="mt-3 min-h-[1rem] font-mono text-[0.65rem] text-anica-paper/45"></p>
          </div>
          <textarea
            id="dsl-editor"
            class="min-h-[420px] min-w-0 max-w-full flex-1 overflow-auto rounded-2xl border-2 border-anica-ink/40 bg-anica-ink/60 p-4 font-mono text-xs leading-relaxed text-anica-paper shadow-inner outline-none transition focus:border-anica-lime"
            spellcheck="false"
          ></textarea>
          <div id="compile-status" class="min-h-[1.5rem] font-mono text-xs text-anica-lime/80"></div>
        </div>

        <div class="order-1 flex min-w-0 flex-col gap-3 lg:order-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">Preview</p>
            <div class="flex min-w-0 flex-wrap items-center justify-end gap-2">
              <button id="btn-expand-playground" class="shrink-0 rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Expand</button>
              <div id="process-source-controls" class="flex min-w-0 flex-wrap items-center justify-end gap-2">
                <label class="cursor-pointer rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">
                  <input id="file-upload" type="file" accept="image/*,video/*" class="hidden" />
                  Upload
                </label>
                <button id="btn-compare" class="max-w-full rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10 select-none">Compare Original</button>
              </div>
              <select id="export-format" class="min-w-0 max-w-full rounded-full border-2 border-anica-lime/40 bg-anica-ink px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">
                <option value="png">PNG</option>
                <option value="mp4-h264">MP4 H.264</option>
                <option value="webm-vp8">WebM VP8</option>
                <option value="webm-vp9">WebM VP9</option>
                <option value="webm-av1">WebM AV1</option>
              </select>
              <button id="btn-download" class="shrink-0 rounded-full border-2 border-anica-lime/50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">Save</button>
            </div>
          </div>
          <div class="relative min-h-[260px] min-w-0 flex-1 overflow-hidden rounded-2xl border-2 border-anica-ink/40 bg-black sm:min-h-[320px]">
            <canvas id="motionloom-canvas-webgpu" class="absolute inset-0 h-full w-full object-contain opacity-0"></canvas>
            <canvas id="motionloom-canvas" class="absolute inset-0 h-full w-full object-contain opacity-100"></canvas>
            <div id="webgpu-status" class="absolute bottom-3 left-3 rounded-full border border-anica-lime/30 bg-anica-ink/80 px-3 py-1 font-mono text-xs text-anica-lime backdrop-blur-md">
              Canvas 2D pipeline
            </div>
          </div>
          <div id="preview-timeline-panel" class="rounded-2xl border border-anica-paper/15 bg-anica-paper/5 p-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
              <button id="btn-preview-play" type="button" class="rounded-full border-2 border-anica-lime/40 px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">
                Pause
              </button>
              <input id="preview-timeline" type="range" min="0" max="0" value="0" step="1" class="motionloom-timeline-range min-w-0 flex-1" />
              <div class="flex items-center justify-between gap-3 font-mono text-[0.65rem] text-anica-paper/60 sm:min-w-[190px]">
                <span id="preview-time">00:00.00 / 00:00.00</span>
                <span id="preview-frame">f0 / 0</span>
              </div>
            </div>
          </div>
          <p class="text-xs text-anica-paper/50">
            Source: <span id="source-name">demo.jpg</span> (public domain)
          </p>
          <p class="mt-1 text-[0.65rem] italic text-anica-paper/35">
            Scene graphs render through MotionLoom WASM. Unsupported native scene DSL now reports an explicit renderer error instead of silently falling back.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    :global(body.motionloom-playground-expanded) {
      overflow: hidden;
    }

    #motionloom-playground-panel,
    #motionloom-workspace,
    #motionloom-workspace > div,
    #github-example-bar,
    #process-github-example-bar {
      min-width: 0;
      max-width: 100%;
    }

    #dsl-editor {
      width: 100%;
      max-width: 100%;
      overflow: auto;
    }

    #github-example-bar select,
    #process-github-example-bar select,
    #export-format {
      min-width: 0;
    }

    #svg-import-mode {
      appearance: none;
      background-color: #11120d !important;
      color: #f2eddf !important;
    }

    #svg-import-mode:hover,
    #svg-import-mode:focus {
      background-color: #1d2117 !important;
      color: #B9FF39 !important;
    }

    #svg-import-mode option {
      background-color: #11120d;
      color: #f2eddf;
    }

    #motionloom-playground-panel.motionloom-expanded {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: flex;
      width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      flex-direction: column;
      gap: 0.75rem;
      overflow: hidden;
      border-radius: 0;
      border-width: 0;
      padding: 0.75rem;
      box-shadow: none;
    }

    #motionloom-playground-panel.motionloom-expanded > .hidden {
      display: none !important;
    }

    #motionloom-playground-panel.motionloom-expanded #motionloom-workspace {
      min-height: 0;
      flex: 1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    #motionloom-playground-panel.motionloom-expanded #motionloom-workspace > div {
      min-height: 0;
    }

    #motionloom-playground-panel.motionloom-expanded #dsl-editor {
      min-height: 0;
      height: 100%;
    }

    #motionloom-playground-panel.motionloom-expanded #motionloom-canvas,
    #motionloom-playground-panel.motionloom-expanded #motionloom-canvas-webgpu {
      object-fit: contain;
    }

    .motionloom-timeline-range {
      accent-color: #B9FF39;
      cursor: pointer;
    }

    .motionloom-control-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .motionloom-control {
      display: grid;
      grid-template-columns: minmax(5.6rem, 0.8fr) minmax(7rem, 1.3fr);
      align-items: center;
      gap: 0.65rem;
      border: 1px solid rgb(242 237 223 / 0.12);
      border-radius: 0.85rem;
      background: rgb(17 18 13 / 0.28);
      padding: 0.55rem 0.65rem;
    }

    .motionloom-control span,
    .motionloom-control output {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: rgb(242 237 223 / 0.68);
    }

    .motionloom-control output {
      text-align: right;
      color: #B9FF39;
    }

    .motionloom-control input,
    .motionloom-control select {
      width: 100%;
      border: 1px solid rgb(242 237 223 / 0.18);
      border-radius: 0.65rem;
      background: rgb(17 18 13 / 0.55);
      padding: 0.35rem 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      color: #f2eddf;
      accent-color: #B9FF39;
      outline: none;
    }

    .motionloom-control input:focus,
    .motionloom-control select:focus {
      border-color: #B9FF39;
    }

    .motionloom-timeline-range::-webkit-slider-runnable-track {
      height: 0.4rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
    }

    .motionloom-timeline-range::-webkit-slider-thumb {
      margin-top: -0.38rem;
    }

    .motionloom-timeline-range::-moz-range-track {
      height: 0.4rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
    }

    @media (max-width: 1023px) {
      #motionloom-playground-panel.motionloom-expanded #motionloom-workspace {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
      }

      #motionloom-playground-panel.motionloom-expanded #dsl-editor {
        min-height: 0;
      }

      .motionloom-control-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 640px) {
      #motionloom-playground-panel {
        border-radius: 1.5rem;
        padding: 0.75rem;
      }

      #github-example-bar,
      #process-github-example-bar {
        align-items: stretch;
      }

      #github-example-bar > span,
      #process-github-example-bar > span {
        width: 100%;
      }

      #github-example-bar select,
      #process-github-example-bar select {
        flex-basis: 100%;
        width: 100%;
      }

      #showcase-number {
        flex: 1 1 4.5rem;
      }

      #process-source-controls {
        flex-basis: 100%;
      }

      #btn-compare {
        white-space: normal;
      }

      .motionloom-control {
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }

      .motionloom-control output {
        text-align: left;
      }
    }
  </style>

  <section class="page-shell py-16">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-anica-signal">Pipeline</p>
      <h2 class="mt-4 text-4xl font-black tracking-[0.06em] text-anica-ink">How it works</h2>
      <p class="mt-4 text-lg leading-8 text-anica-steel">
        MotionLoom keeps the editable source as plain DSL. A future Anica panel can expose After Effects-style controls while preserving the graph underneath.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border-2 border-anica-ink bg-anica-cream p-5 shadow-[6px_6px_0_#11120d]">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-steel">1. Parse</p>
          <p class="mt-2 text-sm text-anica-ink">Slider values update curve keyframes, timings, and node attributes in the DSL text.</p>
        </div>
        <div class="rounded-3xl border-2 border-anica-ink bg-anica-cream p-5 shadow-[6px_6px_0_#11120d]">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-steel">2. Compile</p>
          <p class="mt-2 text-sm text-anica-ink">The same source can be opened, edited, diffed, generated by agents, or compiled by the renderer.</p>
        </div>
        <div class="rounded-3xl border-2 border-anica-ink bg-anica-cream p-5 shadow-[6px_6px_0_#11120d]">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-steel">3. Execute</p>
          <p class="mt-2 text-sm text-anica-ink">Scene graphs render through MotionLoom WASM; native renderer errors are surfaced instead of hidden by a browser fallback.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-shell py-16 text-center">
    <div class="mx-auto max-w-4xl rounded-[2.5rem] border-2 border-anica-ink bg-anica-ink px-6 py-14 text-anica-paper soft-panel md:px-12">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-anica-lime">Native vs Web</p>
      <h2 class="mt-5 text-3xl font-black tracking-[0.06em] md:text-4xl">MotionLoom in the browser</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-anica-paper/72">
        This playground uses a Canvas 2D fallback to demonstrate the graph execution model. The real Anica desktop app runs the same MotionLoom DSL through Rust/WGPU with full GPU compute and video export.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
        <a href="https://github.com/LOVELYZOMBIEYHO/anica/tree/main/crates/motionloom" target="_blank" rel="noreferrer" class="rounded-full border-2 border-anica-lime bg-anica-lime px-7 py-4 text-sm font-black uppercase tracking-[0.18em] text-anica-ink transition hover:-translate-y-1">
          View Rust source
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
    window.MOTIONLOOM_BASE = baseUrl;
  </script>
  <script>
    import { installMotionLoomWebExport } from '../scripts/motionloom-web-export';

    installMotionLoomWebExport();
  </script>

  <script is:inline>
    (function() {
      const canvas = document.getElementById('motionloom-canvas');
      const gpuCanvas = document.getElementById('motionloom-canvas-webgpu');
      const editor = document.getElementById('dsl-editor');
      const resetBtn = document.getElementById('btn-reset');
      const githubExampleBar = document.getElementById('github-example-bar');
      const processGithubExampleBar = document.getElementById('process-github-example-bar');
      const animationControlsPanel = document.getElementById('animation-controls-panel');
      const groupControlSelect = document.getElementById('group-control-select');
      const groupVariableSelect = document.getElementById('group-variable-select');
      const groupVariableValue = document.getElementById('group-variable-value');
      const groupControlStatus = document.getElementById('group-control-status');
      const playgroundPanel = document.getElementById('motionloom-playground-panel');
      const expandPlaygroundBtn = document.getElementById('btn-expand-playground');
      const processSourceControls = document.getElementById('process-source-controls');
      const showcaseNumber = document.getElementById('showcase-number');
      const exampleCategory = document.getElementById('example-category');
      const loadShowcaseBtn = document.getElementById('btn-load-showcase');
      const emptySceneTemplateBtn = document.getElementById('btn-empty-scene-template');
      const svgImportInput = document.getElementById('svg-import');
      const svgImportMode = document.getElementById('svg-import-mode');
      const svgSkipBackground = document.getElementById('svg-skip-background');
      const compileStatus = document.getElementById('compile-status');
      const fileUpload = document.getElementById('file-upload');
      const sourceName = document.getElementById('source-name');
      const downloadBtn = document.getElementById('btn-download');
      const exportFormat = document.getElementById('export-format');
      const webgpuStatus = document.getElementById('webgpu-status');
      const previewTimelinePanel = document.getElementById('preview-timeline-panel');
      const previewPlayBtn = document.getElementById('btn-preview-play');
      const previewTimeline = document.getElementById('preview-timeline');
      const previewTime = document.getElementById('preview-time');
      const previewFrame = document.getElementById('preview-frame');
      const processExampleSelect = document.getElementById('process-example-select');
      const loadProcessExampleBtn = document.getElementById('btn-load-process-example');
      const ctx = canvas.getContext('2d');
      let activePreviewCanvas = canvas;
      let lastPreviewWidth = canvas.width || 1920;
      let lastPreviewHeight = canvas.height || 1080;
      let isComparingOriginal = false;
      let playgroundExpanded = false;
      const previewPlayback = {
        fps: 30,
        totalFrames: 1,
        duration: 1,
        frameFloat: 0,
        playing: true,
        lastTickMs: 0,
        needsRender: true,
      };
      let resetPreviewPlaybackOnNextCompile = true;
      let selectedGroupId = '';
      let cachedGroupControls = [];
      const groupEditableAttrs = [
        { key: 'x', label: 'X', fallback: 0, decimals: 1, placeholder: 'e.g. -10' },
        { key: 'y', label: 'Y', fallback: 0, decimals: 1, placeholder: 'e.g. 24' },
        { key: 'rotation', label: 'Rotation', fallback: 0, decimals: 1, placeholder: 'degrees' },
        { key: 'scale', label: 'Scale', fallback: 1, decimals: 2, placeholder: 'e.g. 1.25' },
        { key: 'scaleX', label: 'Scale X', fallback: 1, decimals: 2, placeholder: 'e.g. 1.25' },
        { key: 'scaleY', label: 'Scale Y', fallback: 1, decimals: 2, placeholder: 'e.g. 0.85' },
