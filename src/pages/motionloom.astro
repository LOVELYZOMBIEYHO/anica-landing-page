---
import BaseLayout from '@components/BaseLayout.astro';
// @ts-expect-error Astro executes frontmatter in Node; this project omits Node ambient types.
import { createHash } from 'node:crypto';
// @ts-expect-error Astro executes frontmatter in Node; this project omits Node ambient types.
import { readFileSync } from 'node:fs';

// Tie the browser cache key to the generated binary so every WASM rebuild gets a new URL.
const motionLoomWasmVersion = createHash('sha256')
  .update(readFileSync('public/motionloom-wasm/pkg/motionloom_bg.wasm'))
  .digest('hex')
  .slice(0, 16);
---

<BaseLayout
  title="MotionLoom - GPU Effect Engine"
  description="MotionLoom is Anica's GPU-accelerated effect and motion graph engine. Live demo with full graph DSL."
  ogImage="/motionloom-og.png"
>
  <section class="page-shell py-16">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="inline-flex rounded-full border-2 border-anica-ink bg-anica-lime px-4 py-2 font-mono text-xs font-bold uppercase tracking-[0.24em] shadow-[4px_4px_0_#11120d]">
        GPU effect engine
      </p>
      <h1 class="mt-8 text-5xl font-black leading-[0.9] tracking-[-0.08em] text-anica-ink md:text-7xl">
        MotionLoom
      </h1>
      <p class="mt-6 text-xl leading-8 text-anica-steel">
        A graph-based video effects and motion graphics engine built on WGPU. This playground shows the direction for Anica: visual animation controls that write real MotionLoom DSL.
      </p>
    </div>
  </section>

  <section class="page-shell py-4 md:py-8">
    <div id="motionloom-playground-panel" class="grid max-w-full gap-4 overflow-hidden rounded-[2.5rem] border-2 border-anica-ink bg-anica-ink p-4 ink-panel md:gap-6 md:p-10">
      <div class="hidden text-center lg:block">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-anica-lime">Live playground</p>
        <h2 class="mt-3 text-3xl font-black tracking-[0.06em] text-anica-paper md:text-4xl">Controls &rarr; DSL &rarr; Preview</h2>
        <p class="mx-auto mt-3 max-w-xl text-lg leading-8 text-anica-paper/72">
          Adjust animation values in the control panel, inspect the generated XML-like graph, then render the same DSL in the browser preview.
        </p>
      </div>

      <div id="motionloom-workspace" class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="order-2 flex min-w-0 flex-col gap-3 lg:order-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">MotionLoom Graph</p>
            <div class="flex shrink-0 gap-2">
              <button id="btn-reset" class="rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Process</button>
              <button id="btn-scene" class="rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Scene</button>
            </div>
          </div>
          <div id="github-example-bar" class="flex w-full min-w-0 flex-wrap items-center gap-2 rounded-2xl border border-anica-paper/15 bg-anica-paper/5 px-3 py-2">
            <span class="shrink-0 font-mono text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper/60">GitHub example</span>
            <select
              id="example-category"
              class="min-w-0 max-w-full flex-1 rounded-full border border-anica-paper/25 bg-anica-ink/70 px-3 py-1 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
            >
              <option value="showcase">showcase</option>
              <option value="scene">scene</option>
              <option value="process">process</option>
              <option value="text">text</option>
              <option value="material_and_texture">material_and_texture</option>
              <option value="simulation">simulation</option>
            </select>
            <input
              id="showcase-number"
              class="w-16 rounded-full border border-anica-paper/25 bg-anica-ink/70 px-3 py-1 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
              inputmode="numeric"
              min="1"
              placeholder="1"
              type="number"
              value="1"
            />
            <button id="btn-load-showcase" class="shrink-0 rounded-full border border-anica-paper/30 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Load</button>
            <button id="btn-inspect-glb" class="shrink-0 rounded-full border border-anica-lime/40 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">Inspect GLB skeleton</button>
            <button id="btn-empty-scene-template" class="shrink-0 rounded-full border border-anica-lime/40 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">Empty template</button>
            <select id="svg-import-mode" class="shrink-0 rounded-full border border-anica-lime/40 bg-anica-black px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime outline-none transition hover:bg-anica-lime/10">
              <option value="svg">Import as SVG tag</option>
              <option value="path" selected>Import as Path DSL</option>
            </select>
            <label class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-full border border-anica-lime/25 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">
              <input id="svg-skip-background" type="checkbox" class="h-3 w-3 accent-anica-lime" checked />
              Skip SVG background
            </label>
            <label class="shrink-0 cursor-pointer rounded-full border border-anica-lime/40 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">
              <input id="svg-import" type="file" accept=".svg,image/svg+xml" class="hidden" />
              Import SVG
            </label>
          </div>
          <details id="glb-inspection-panel" class="hidden rounded-2xl border border-anica-lime/25 bg-anica-black/55 p-3">
            <summary id="glb-inspection-summary" class="cursor-pointer font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">GLB skeleton report</summary>
            <pre id="glb-inspection-report" class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap break-words font-mono text-[0.68rem] leading-relaxed text-anica-paper/75"></pre>
          </details>
          <div id="process-github-example-bar" class="hidden w-full min-w-0 flex-wrap items-center gap-2 rounded-2xl border border-anica-paper/15 bg-anica-paper/5 px-3 py-2">
            <span class="shrink-0 font-mono text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper/60">GitHub process example</span>
            <select
              id="process-example-select"
              class="min-w-0 max-w-full flex-1 rounded-full border border-anica-paper/25 bg-anica-ink/70 px-3 py-1 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
            >
              <option value="">Loading process examples...</option>
            </select>
            <button id="btn-load-process-example" class="shrink-0 rounded-full border border-anica-paper/30 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Load</button>
          </div>
          <div id="animation-controls-panel" class="rounded-2xl border border-anica-paper/15 bg-anica-paper/5 p-3">
            <div class="motionloom-inspector-toolbar mb-3">
              <select
                id="scene-tool-panel-select"
                aria-label="Scene tool panel"
                class="rounded-lg border border-anica-lime/25 bg-anica-ink/70 px-2 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-[0.22em] text-anica-lime outline-none transition hover:bg-anica-lime/5 focus:border-anica-lime"
              >
                <option value="scene-controls" class="bg-anica-ink text-anica-lime">Scene controls</option>
                <option value="drawing-tools" class="bg-anica-ink text-anica-lime">Drawing tools</option>
                <option value="puppet-warp" class="bg-anica-ink text-anica-lime">Puppet Warp</option>
              </select>
              <button
                id="scene-inspector-toggle"
                type="button"
                class="motionloom-collapse-button"
                aria-controls="scene-controls-content"
                aria-expanded="false"
                title="Expand Scene Controls"
              ><span>Expand</span><span class="motionloom-collapse-chevron" aria-hidden="true">⌃</span></button>
            </div>

            <div id="scene-inspector-summary" class="motionloom-inspector-summary" aria-label="Scene selection quick controls">
              <div class="motionloom-summary-selection-modes" role="group" aria-label="Scene selection mode">
                <button type="button" data-semantic-mode="click" aria-pressed="true">Pointer</button>
                <button type="button" data-semantic-mode="marquee" aria-pressed="false">Marquee</button>
                <button type="button" data-semantic-mode="lasso" aria-pressed="false">Lasso</button>
                <button type="button" data-semantic-mode="unselect" aria-pressed="false">Unselect</button>
              </div>
              <output data-semantic-count>0 Elements</output>
              <button type="button" data-delete-semantic disabled>Delete Selected</button>
            </div>

            <div id="scene-controls-content" class="hidden">
              <section class="motionloom-inspector-section" data-inspector-section="transform">
                <button class="motionloom-section-toggle" type="button" aria-expanded="true" aria-controls="scene-transform-body">
                  <span>Transform</span><span class="motionloom-collapse-chevron" aria-hidden="true">⌃</span>
                </button>
                <div id="scene-transform-body" class="motionloom-section-body">
                  <p class="mt-1 text-xs text-anica-paper/45">Select a Group id and variable from the current DSL, then edit its value.</p>

                  <label class="mb-3 mt-3 grid gap-2">
                    <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.18em] text-anica-paper/60">Group id</span>
                    <select
                      id="group-control-select"
                      class="rounded-xl border border-anica-paper/25 bg-anica-ink/70 px-3 py-2 font-mono text-xs font-bold text-anica-paper outline-none transition focus:border-anica-lime"
                    ></select>
                  </label>

                  <div class="motionloom-control-grid">
                    <label class="motionloom-control">
                      <span>Variable</span>
                      <select id="group-variable-select"></select>
                    </label>
                    <label class="motionloom-control">
                      <span>Value</span>
                      <input id="group-variable-value" type="text" inputmode="decimal" autocomplete="off" />
                    </label>
                  </div>
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                    <div class="flex gap-2">
                      <button
                        id="scene-history-undo"
                        type="button"
                        disabled
                        class="rounded-lg border border-anica-paper/25 px-3 py-2 font-mono text-[0.65rem] font-bold uppercase tracking-[0.12em] text-anica-paper transition hover:border-anica-lime hover:text-anica-lime disabled:cursor-not-allowed disabled:opacity-35"
                      >Undo</button>
                      <button
                        id="scene-history-redo"
                        type="button"
                        disabled
                        class="rounded-lg border border-anica-paper/25 px-3 py-2 font-mono text-[0.65rem] font-bold uppercase tracking-[0.12em] text-anica-paper transition hover:border-anica-lime hover:text-anica-lime disabled:cursor-not-allowed disabled:opacity-35"
                      >Redo</button>
                    </div>
                    <button
                      id="delete-group-control"
                      type="button"
                      class="rounded-lg border border-anica-signal/50 px-3 py-2 font-mono text-[0.65rem] font-bold uppercase tracking-[0.12em] text-anica-signal transition hover:bg-anica-signal/10 disabled:cursor-not-allowed disabled:opacity-35"
                    >Delete Group</button>
                  </div>
                  <p id="group-control-status" class="mt-3 min-h-[1rem] font-mono text-[0.65rem] text-anica-paper/45"></p>

                  <div class="mt-4 rounded-xl border border-anica-lime/20 bg-anica-ink/35 p-3">
                    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                      <strong class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-anica-lime">
                        Combine Groups <span id="combine-current-group-label" class="text-anica-paper/60"></span>
                      </strong>
                      <span class="font-mono text-[0.58rem] text-anica-paper/40">Selection moves inside · Group links</span>
                    </div>
                    <div class="grid gap-2 sm:grid-cols-2">
                      <label class="grid gap-1">
                        <span class="font-mono text-[0.58rem] font-bold uppercase tracking-[0.12em] text-anica-paper/50">Combine current with</span>
                        <select id="combine-group-select" class="min-w-0 rounded-lg border border-anica-paper/25 bg-anica-ink/70 px-3 py-2 font-mono text-[0.65rem] font-bold text-anica-paper outline-none focus:border-anica-lime"></select>
                      </label>
                      <label class="grid gap-1">
                        <span class="font-mono text-[0.58rem] font-bold uppercase tracking-[0.12em] text-anica-paper/50">Combined Group ID</span>
                        <input id="combine-group-id" type="text" value="" class="min-w-0 rounded-lg border border-anica-paper/25 bg-anica-ink/70 px-3 py-2 font-mono text-[0.65rem] font-bold text-anica-paper outline-none focus:border-anica-lime" />
                      </label>
                    </div>
                    <button id="combine-groups-control" type="button" class="mt-3 rounded-lg border border-anica-lime/45 px-3 py-2 font-mono text-[0.65rem] font-bold uppercase tracking-[0.12em] text-anica-lime transition hover:bg-anica-lime/10 disabled:cursor-not-allowed disabled:opacity-35">Combine Groups</button>
                    <p id="combine-group-status" class="mt-2 min-h-[1rem] font-mono text-[0.6rem] text-anica-paper/45">Select the first Group above, then choose the second Group here.</p>
                  </div>
                </div>
              </section>

              <section class="drawing-semantic-panel motionloom-inspector-section" data-inspector-section="selection" aria-label="Scene element selection">
                <button class="drawing-semantic-heading motionloom-section-toggle" type="button" aria-expanded="true" aria-controls="scene-selection-body">
                  <strong>Scene Selection</strong><span class="motionloom-section-heading-end"><output id="drawing-semantic-count" data-semantic-count>0 Elements</output><span class="motionloom-collapse-chevron" aria-hidden="true">⌃</span></span>
                </button>
                <div id="scene-selection-body" class="motionloom-section-body">
                  <p>Select Path, Rect, Circle, Ellipse, Line, Text and other visible Scene elements. Shift adds; Option/Alt removes.</p>
                  <div class="drawing-semantic-modes" role="group" aria-label="Scene selection mode">
                    <button type="button" data-semantic-mode="click" aria-pressed="true">Pointer</button>
                    <button type="button" data-semantic-mode="marquee" aria-pressed="false">Marquee</button>
                    <button type="button" data-semantic-mode="lasso" aria-pressed="false">Lasso</button>
                    <button type="button" data-semantic-mode="unselect" aria-pressed="false">Unselect</button>
                  </div>
                  <div class="drawing-semantic-actions">
                    <button type="button" id="drawing-select-similar">Select Similar</button>
                    <button type="button" id="drawing-grow-selection">Grow Connected</button>
                    <button type="button" id="drawing-clear-semantic">Clear</button>
                    <button type="button" id="drawing-split-semantic-path">Split Path</button>
                    <button type="button" id="drawing-locate-semantic" disabled>Locate DSL</button>
                    <button type="button" data-delete-semantic disabled>Delete Selected</button>
                  </div>
                  <output id="drawing-semantic-path-state" class="mt-2 block min-h-[1rem] font-mono text-[0.65rem] text-anica-lime/75">Select one element to inspect its DSL source.</output>
                  <div class="drawing-semantic-options">
                    <label><span>Color tolerance</span><input id="drawing-semantic-color" type="number" min="0" max="442" step="1" value="56" /></label>
                    <label><span>Adjacency px</span><input id="drawing-semantic-adjacency" type="number" min="0" step="1" value="12" /></label>
                    <label><span>Z-order window</span><input id="drawing-semantic-z" type="number" min="0" step="1" value="64" /></label>
                    <label><span>Similarity score</span><input id="drawing-semantic-score" type="number" min="0" max="1" step="0.05" value="0.52" /></label>
                  </div>
                  <div class="drawing-semantic-group-row">
                    <label><span>New Group ID</span><input id="drawing-semantic-group-id" type="text" value="semantic_group_001" /></label>
                    <button type="button" id="drawing-create-semantic-group">Create Group</button>
                  </div>
                  <p id="scene-selection-status" class="mt-3 min-h-[1rem] font-mono text-[0.65rem] text-anica-paper/45">Pointer selects exact visible Scene elements.</p>
                </div>
              </section>
            </div>

            <div id="drawing-tools-content" class="hidden min-h-[11rem]" aria-label="Drawing tools"></div>
            <div id="puppet-warp-content" class="hidden min-h-[11rem]" aria-label="Puppet Warp tools"></div>
          </div>
          <textarea
            id="dsl-editor"
            class="min-h-[420px] min-w-0 max-w-full flex-1 overflow-auto rounded-2xl border-2 border-anica-ink/40 bg-anica-ink/60 p-4 font-mono text-xs leading-relaxed text-anica-paper shadow-inner outline-none transition focus:border-anica-lime"
            spellcheck="false"
          ></textarea>
          <div id="compile-status" class="min-h-[1.5rem] font-mono text-xs text-anica-lime/80"></div>
        </div>

        <div class="order-1 flex min-w-0 flex-col gap-3 lg:order-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">Preview</p>
            <div class="flex min-w-0 flex-wrap items-center justify-end gap-2">
              <button id="btn-expand-playground" class="shrink-0 rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">Expand</button>
              <div id="process-source-controls" class="flex min-w-0 flex-wrap items-center justify-end gap-2">
                <label class="cursor-pointer rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10">
                  <input id="file-upload" type="file" accept="image/*,video/*" class="hidden" />
                  Upload
                </label>
                <button id="btn-compare" class="max-w-full rounded-full border-2 border-anica-paper/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-paper transition hover:bg-anica-paper/10 select-none">Compare Original</button>
              </div>
              <select id="export-format" class="min-w-0 max-w-full rounded-full border-2 border-anica-lime/40 bg-anica-ink px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-anica-lime">
                <option value="png">PNG</option>
                <option value="mp4-h264">MP4 H.264</option>
                <option value="mp4-hevc-main">MP4 HEVC Main (8-bit)</option>
                <option value="webm-vp8">WebM VP8</option>
                <option value="webm-vp9">WebM VP9</option>
                <option value="webm-av1">WebM AV1</option>
              </select>
              <button id="btn-download" class="shrink-0 rounded-full border-2 border-anica-lime/50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">Save</button>
            </div>
          </div>
          <div id="motionloom-preview-stage" class="relative min-h-[260px] min-w-0 flex-1 overflow-hidden rounded-2xl border-2 border-anica-ink/40 bg-black sm:min-h-[320px]">
            <canvas id="motionloom-canvas-webgpu" class="absolute inset-0 h-full w-full object-contain opacity-0"></canvas>
            <canvas id="motionloom-canvas" class="absolute inset-0 h-full w-full object-contain opacity-100"></canvas>
            <svg id="motionloom-drawing-overlay" class="pointer-events-none absolute inset-0 hidden h-full w-full touch-none" aria-label="MotionLoom drawing canvas"></svg>
            <svg id="motionloom-puppet-overlay" class="pointer-events-none absolute inset-0 z-30 hidden h-full w-full touch-none" aria-label="MotionLoom Puppet Warp pins"></svg>
            <div id="webgpu-status" class="absolute bottom-3 left-3 rounded-full border border-anica-lime/30 bg-anica-ink/80 px-3 py-1 font-mono text-xs text-anica-lime backdrop-blur-md">
              Canvas 2D pipeline
            </div>
          </div>
          <div id="preview-timeline-panel" class="rounded-2xl border border-anica-paper/15 bg-anica-paper/5 p-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
              <button id="btn-preview-play" type="button" class="rounded-full border-2 border-anica-lime/40 px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-anica-lime transition hover:bg-anica-lime/10">
                Pause
              </button>
              <input id="preview-timeline" type="range" min="0" max="0" value="0" step="1" class="motionloom-timeline-range min-w-0 flex-1" />
              <div class="flex items-center justify-between gap-3 font-mono text-[0.65rem] text-anica-paper/60 sm:min-w-[190px]">
                <span id="preview-time">00:00.00 / 00:00.00</span>
                <span id="preview-frame">f0 / 0</span>
              </div>
            </div>
          </div>
          <p class="text-xs text-anica-paper/50">
            Source: <span id="source-name">demo.jpg</span> (public domain)
          </p>
          <p class="mt-1 text-[0.65rem] italic text-anica-paper/35">
            Scene graphs render through MotionLoom WASM. Unsupported native scene DSL now reports an explicit renderer error instead of silently falling back.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    :global(body.motionloom-playground-expanded) {
      overflow: hidden;
    }

    #motionloom-playground-panel,
    #motionloom-workspace,
    #motionloom-workspace > div,
    #github-example-bar,
    #process-github-example-bar {
      min-width: 0;
      max-width: 100%;
    }

    #dsl-editor {
      width: 100%;
      max-width: 100%;
      min-height: max(420px, 50vh);
      overflow: auto;
    }

    .motionloom-inspector-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
    }

    .motionloom-collapse-button,
    .motionloom-section-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.55rem;
      border: 1px solid rgb(185 255 57 / 0.28);
      border-radius: 0.55rem;
      background: #0d0f0b;
      padding: 0.38rem 0.58rem;
      color: #B9FF39;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .motionloom-collapse-button.hidden {
      display: none;
    }

    .motionloom-collapse-button:hover,
    .motionloom-section-toggle:hover {
      border-color: #B9FF39;
      background: rgb(185 255 57 / 0.06);
    }

    .motionloom-collapse-chevron {
      display: inline-block;
      font-size: 0.75rem;
      line-height: 1;
      transition: transform 160ms ease;
    }

    [aria-expanded="false"] > .motionloom-collapse-chevron,
    [aria-expanded="false"] .motionloom-collapse-chevron {
      transform: rotate(180deg);
    }

    .motionloom-inspector-summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      border: 1px solid rgb(185 255 57 / 0.24);
      border-radius: 0.7rem;
