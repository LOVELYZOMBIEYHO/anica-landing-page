---
import { navItems, site } from '@data/site';
import { withBase } from '@utils/url';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const baseHome = withBase('/').replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-50 border-b-2 border-anica-ink/10 bg-anica-paper/82 backdrop-blur-xl">
  <div class="page-shell flex items-center justify-between gap-5 py-4">
    <a href={withBase('/')} class="group flex items-center gap-3" aria-label="Anica home">
      <img
        src={withBase('/anica-navbar-logo.png')}
        alt="Anica logo"
        class="h-11 w-24 rounded-2xl object-contain transition-transform group-hover:-rotate-3"
        loading="eager"
      />
      <span class="leading-none">
        <span class="block text-xl font-black tracking-[-0.04em]">{site.name}</span>
        <span class="hidden font-mono text-[0.62rem] uppercase tracking-[0.32em] text-anica-steel sm:block">agentic video editor</span>
      </span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-2 rounded-full border-2 border-anica-ink/10 bg-anica-cream/72 p-1 md:flex">
      {navItems.map((item) => {
        const itemPath = withBase(item.href).replace(/\/$/, '') || '/';
        const isActive = item.href === '/'
          ? currentPath === baseHome
          : currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);

        return (
          <a
            href={withBase(item.href)}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-bold transition',
              isActive
                ? 'bg-anica-ink text-anica-lime'
                : 'text-anica-ink/70 hover:bg-anica-ink/10 hover:text-anica-ink',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.repoUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="Open Anica on GitHub"
        class="grid size-11 place-items-center rounded-full border-2 border-anica-ink bg-anica-paper text-anica-ink shadow-[4px_4px_0_#11120d] transition hover:-translate-y-0.5 hover:bg-anica-lime hover:shadow-[6px_6px_0_#11120d]"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
          <path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.11.79-.25.79-.56v-2.15c-3.22.7-3.9-1.38-3.9-1.38-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.57-.29-5.27-1.28-5.27-5.72 0-1.26.45-2.3 1.19-3.11-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.18 1.19A11.1 11.1 0 0 1 12 5.94c.98 0 1.96.13 2.88.39 2.2-1.5 3.17-1.19 3.17-1.19.64 1.59.24 2.77.12 3.06.74.81 1.18 1.85 1.18 3.11 0 4.45-2.71 5.42-5.29 5.71.42.36.79 1.07.79 2.16v3.16c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z" />
        </svg>
      </a>
      <a
        href={site.youtubeUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="Open Anica on YouTube"
        class="grid size-11 place-items-center rounded-full border-2 border-anica-ink bg-anica-paper text-anica-ink shadow-[4px_4px_0_#11120d] transition hover:-translate-y-0.5 hover:bg-anica-lime hover:shadow-[6px_6px_0_#11120d]"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.12C19.55 3.58 12 3.58 12 3.58s-7.55 0-9.4.5A3 3 0 0 0 .5 6.2 31.1 31.1 0 0 0 0 12a31.1 31.1 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.12c1.85.5 9.4.5 9.4.5s7.55 0 9.4-.5a3 3 0 0 0 2.1-2.12A31.1 31.1 0 0 0 24 12a31.1 31.1 0 0 0-.5-5.8ZM9.6 15.56V8.44L15.86 12 9.6 15.56Z" />
        </svg>
      </a>
    </div>
  </div>

  <nav aria-label="Mobile navigation" class="page-shell flex gap-2 pb-4 md:hidden">
    {navItems.map((item) => {
      const itemPath = withBase(item.href).replace(/\/$/, '') || '/';
      const isActive = item.href === '/'
        ? currentPath === baseHome
        : currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);

      return (
        <a
          href={withBase(item.href)}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'flex-1 rounded-full border border-anica-ink/10 px-3 py-2 text-center text-xs font-bold',
            isActive ? 'bg-anica-ink text-anica-lime' : 'bg-anica-cream/75 text-anica-ink/70',
          ]}
        >
          {item.label}
        </a>
      );
    })}
  </nav>
</header>
